{
  "name": "project-management",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --ext .js,.ts,.tsx --report-unused-disable-directives --max-warnings 0"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --ext .js,.ts,.tsx --report-unused-disable-directives --max-warnings 0 --fix"
      }
    },
    "check:cycles": {
      "executor": "nx:run-commands",
      "options": {
        "command": "madge --circular --extensions ts,tsx src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo No tests specified yet"
      },
      "configurations": {
        "ci": {}
      }
    }
  }
}
