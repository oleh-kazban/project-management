{
  "name": "project-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:cycles": "madge --circular --extensions ts,tsx src",
    "lint": "eslint . --ext .js,.ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server": "json-server --watch db.json --port 3000",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "react": "19.0.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.0.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "10.0.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react": "4.0.3",
    "autoprefixer": "10.4.14",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "json-server": "0.17.4",
    "madge": "8.0.0",
    "postcss": "8.4.27",
    "prettier": "3.3.3",
    "tailwindcss": "3.3.3",
    "typescript": "5.5.4",
    "vite": "4.4.5"
  }
}